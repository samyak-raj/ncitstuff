    <diagram id="o0a0BGmi62f_jAwJLf9x" name="Page-1">
        <mxGraphModel dx="3052" dy="2327" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Guest\n    participant Reservation\n    participant Room Type\n    participant Room\n    participant Services\n    participant Service Usage\n    participant Payment\n\n    %% --- 1. RESERVATION &amp; ROOM ALLOCATION ---\n    Guest-&gt;&gt;Reservation: createReservation(checkIn, checkOut, numGuests)\n    activate Reservation\n    \n    Reservation-&gt;&gt;Room Type: getAvailableRooms()\n    activate Room Type\n    Room Type-&gt;&gt;Room: checkAvailability()\n    activate Room\n    \n    alt Room Available\n        Room--&gt;&gt;Room Type: roomAvailable\n        Room Type--&gt;&gt;Reservation: roomDetails(price, basePrice)\n        deactivate Room\n        deactivate Room Type\n\n        Reservation-&gt;&gt;Room: assignRoom()\n        activate Room\n        Room--&gt;&gt;Reservation: roomAssigned\n        deactivate Room\n\n        Reservation-&gt;&gt;Reservation: calculateTotal()\n\n    else Room Not Available\n        Room--&gt;&gt;Room Type: roomUnavailable\n        activate Room\n        activate Room Type\n        Room Type--&gt;&gt;Reservation: noRoomsAvailable\n        deactivate Room\n        deactivate Room Type\n\n        Reservation--&gt;&gt;Guest: reservationRejected()\n    end\n\n    %% --- 2. ADDING ADDITIONAL SERVICES ---\n    Note over Guest, Service Usage: Optional: Guest adds an extra service during stay\n    Guest-&gt;&gt;Services: addService()\n    activate Services\n    Services-&gt;&gt;Service Usage: addService(quantity, date)\n    activate Service Usage\n    Service Usage-&gt;&gt;Service Usage: calculateCharge()\n    Service Usage--&gt;&gt;Services: chargeCalculated\n    deactivate Service Usage\n    Services--&gt;&gt;Guest: serviceAdded\n    deactivate Services\n\n    %% --- 3. PAYMENT FLOW ---\n    Guest-&gt;&gt;Payment: makePayment(amount, method)\n    activate Payment\n    Payment-&gt;&gt;Payment: generateReceipt()\n    Payment--&gt;&gt;Guest: paymentReceipt\n    deactivate Payment\n\n    Reservation-&gt;&gt;Payment: verifyPayment()\n    \n    alt Payment Verified\n        activate Payment\n        Payment--&gt;&gt;Reservation: paymentConfirmed\n        deactivate Payment\n\n        Reservation-&gt;&gt;Reservation: confirmReservation()\n        Reservation--&gt;&gt;Guest: bookingConfirmed()\n\n    else Payment Failed\n        activate Payment\n        Payment--&gt;&gt;Reservation: paymentRejected\n        deactivate Payment\n\n        Reservation-&gt;&gt;Room: updateStatus(Available)\n        activate Room\n        Room--&gt;&gt;Reservation: roomReleased\n        deactivate Room\n\n        Reservation-&gt;&gt;Reservation: cancelReservation()\n        Reservation--&gt;&gt;Guest: bookingFailed()\n    end\n\n    deactivate Reservation&quot;&#xa;}" id="18">
