        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle System Sequence Diagram - Make Reservation\n\nskinparam Shadowing false\nskinparam ParticipantPadding 80\nskinparam BoxPadding 15\nskinparam Padding 15\nskinparam ResponseMessageBelowArrow false\nskinparam SequenceMessageAlign center\n\nactor Guest\nparticipant \&quot;Hotel Management System\&quot; as HMS\n\nloop Until a suitable room is selected\n\n    Guest -&gt; HMS : searchAvailableRooms(criteria)\n    HMS --&gt; Guest : availableRoomList()\n\n    alt Rooms Available\n\n        Guest -&gt; HMS : selectRoom(roomID)\n        Guest -&gt; HMS : enterReservationDetails(checkIn,\\ncheckOut,\\nnumberOfGuests)\n\n        alt Reservation Details Valid\n\n            HMS --&gt; Guest : reservationSummary(totalAmount)\n\n            Guest -&gt; HMS : confirmReservation()\n\n            HMS --&gt; Guest : reservationConfirmed(reservationID)\n\n        else Invalid Reservation Details\n\n            HMS --&gt; Guest : validationError()\n\n        end\n\n    else No Rooms Available\n\n        HMS --&gt; Guest : noRoomsAvailable()\n\n    end\n\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pPpmULG4kc0dCefBjXKk-85">
